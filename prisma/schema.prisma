generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Login account. `perms` holds module keys (see src/lib/domain.ts MODULES);
/// it starts as the role default and can be adjusted per person by an Admin.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String
  perms        String[]
  active       Boolean  @default(true)
  /// Work contact details: email receives notifications and password-reset links; phone is shown to technicians
  email        String   @default("")
  phone        String   @default("")
  dept         String   @default("")
  createdAt    DateTime @default(now())

  sessions        Session[]
  passwordResets  PasswordReset[]
  ticketsOpened   Ticket[]          @relation("TicketRequester")
  ticketsAssigned Ticket[]          @relation("TicketAssignee")
  claimsAssigned  Claim[]           @relation("ClaimAssignee")
  chatsAssigned   ChatThread[]      @relation("ChatAssignee")
  prsRequested    PurchaseRequest[] @relation("PRRequester")
  prsApproved1    PurchaseRequest[] @relation("PRApprover1")
  prsApproved     PurchaseRequest[] @relation("PRApprover")
}

model Session {
  /// sha256 of the cookie token — the raw token is never stored
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One-time "forgot password" link sent by email. Only the sha256 of the token is stored.
model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, createdAt])
}

/// A product in stock. `price` = selling price incl. VAT (storefront); `cost` = purchase cost
/// used on purchase requests and for stock value. `reserved` = units held by orders awaiting payment.
model InventoryItem {
  sku            String          @id
  name           String
  cat            String
  unit           String
  qty            Int
  min            Int
  price          Decimal         @db.Decimal(12, 2)
  cost           Decimal         @default(0) @db.Decimal(12, 2)
  compareAt      Decimal?        @db.Decimal(12, 2)
  loc            String
  reserved       Int             @default(0)
  slug           String?         @unique
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId        String?
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// Key specs used by filters and the PC builder, e.g. { socket, ramType, tdpW, wattage, formFactor }
  specs          Json            @default("{}")
  description    String          @default("")
  warrantyMonths Int             @default(12)
  /// Listed on the storefront
  active         Boolean         @default(false)
  serialTracked  Boolean         @default(false)
  createdAt      DateTime        @default(now())
  moves          StockMove[]
  images         ProductImage[]
  serials        SerialNumber[]
  cartItems      CartItem[]
  buildItems     PcBuildItem[]
  orderLines     OrderLine[]
  claimParts     ClaimPart[]
  promoItems     PromotionItem[]

  @@index([categoryId, active])
  @@index([brandId])
}

model Category {
  id       String          @id @default(cuid())
  slug     String          @unique // cpu, mainboard, ram, vga …
  name     String
  parentId String?
  parent   Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]      @relation("CategoryTree")
  sort     Int             @default(0)
  items    InventoryItem[]
}

model Brand {
  id    String          @id @default(cuid())
  slug  String          @unique
  name  String
  /// Logo uploaded by the shop (file name in the upload store); without one the name is shown as a wordmark
  logo  String?
  items InventoryItem[]
}

model ProductImage {
  id   String        @id @default(cuid())
  sku  String
  item InventoryItem @relation(fields: [sku], references: [sku], onDelete: Cascade)
  file String // file name in the upload store
  ord  Int

  @@index([sku, ord])
}

/// One physical unit of a serial-tracked product.
model SerialNumber {
  serial      String        @id
  sku         String
  item        InventoryItem @relation(fields: [sku], references: [sku])
  /// in_stock | sold | claim | returned
  status      String        @default("in_stock")
  receivedRef String // PR number it arrived on
  orderLineId String?
  orderLine   OrderLine?    @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  claims      Claim[]

  @@index([sku, status])
}

model Supplier {
  id        String            @id @default(cuid())
  name      String
  taxId     String            @default("")
  phone     String            @default("")
  email     String            @default("")
  active    Boolean           @default(true)
  purchases PurchaseRequest[]
}

model StockMove {
  id   String        @id @default(cuid())
  t    DateTime      @default(now())
  sku  String
  item InventoryItem @relation(fields: [sku], references: [sku])
  type String // in | out | sale | return
  qty  Int
  ref  String
  by   String

  @@index([t])
}

model Ticket {
  id          String    @id // TCK-1050
  title       String
  cat         String
  urgency     String // low | medium | high | critical
  assetTag    String    @default("")
  desc        String
  requesterId String
  requester   User      @relation("TicketRequester", fields: [requesterId], references: [id])
  created     DateTime  @default(now())
  status      String // new | assigned | progress | waiting | resolved | closed
  assigneeId  String?
  assignee    User?     @relation("TicketAssignee", fields: [assigneeId], references: [id])
  resolvedAt  DateTime?
  closedAt    DateTime?
  rating      Int?
  ratingNote  String    @default("")

  images  TicketImage[]
  parts   TicketPart[]
  history TicketEvent[]

  @@index([status])
  @@index([requesterId])
  @@index([assigneeId])
}

model TicketImage {
  id       String       @id @default(cuid())
  ticketId String
  ticket   Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  file     String // file name inside UPLOAD_DIR
  mime     String
  name     String
  size     Int
  ord      Int
  kind     String       @default("report") // report = from the requester | work = from the technician
  eventId  String? // the status update a work photo was attached to
  event    TicketEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model TicketPart {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sku      String
  name     String
  qty      Int

  @@id([ticketId, sku])
}

model TicketEvent {
  id       String        @id @default(cuid())
  ticketId String
  ticket   Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  t        DateTime      @default(now())
  text     String
  by       String
  images   TicketImage[]

  @@index([ticketId, t])
}

model PurchaseRequest {
  id          String    @id // PR-2026-0015
  date        DateTime  @default(now())
  requesterId String
  requester   User      @relation("PRRequester", fields: [requesterId], references: [id])
  vendor      String
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  note        String    @default("")
  /// pending | pending_exec | approved | rejected | received
  status      String
  approver1Id String?
  approver1   User?     @relation("PRApprover1", fields: [approver1Id], references: [id])
  decided1    DateTime?
  approverId  String?
  approver    User?     @relation("PRApprover", fields: [approverId], references: [id])
  decided     DateTime?
  reason      String    @default("")
  received    DateTime?
  lines       PRLine[]

  @@index([status])
}

model PRLine {
  id    String          @id @default(cuid())
  prId  String
  pr    PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  ord   Int
  sku   String
  name  String
  unit  String
  qty   Int
  price Decimal         @db.Decimal(12, 2)

  @@index([prId])
}

/// Append-only. UPDATE / DELETE / TRUNCATE are rejected by a database trigger
/// (see the init migration), so not even an Admin with DB credentials used by
/// the app can rewrite history.
model AuditLog {
  id     BigInt   @id @default(autoincrement())
  t      DateTime @default(now())
  userId String?
  by     String
  role   String
  cat    String
  action String
  target String   @default("")
  detail String   @default("")

  @@index([t])
  @@index([cat])
}

/// Document number sequences (tck, pr, ord)
model Counter {
  key   String @id
  value Int
}

// ── Storefront customers (person A) ─────────────────────────────────────────

/// A shop customer. Separate from User (staff): customers never reach the back office.
model Customer {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String
  phone        String            @default("")
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  addresses    Address[]
  cart         Cart?
  builds       PcBuild[]
  orders       Order[]
  sessions     CustomerSession[]
  claims       Claim[]
  chats        ChatThread[]
}

/// A signed-in customer's browser. Kept apart from staff sessions so a customer cookie can never open the back office.
model CustomerSession {
  /// sha256 of the cookie token — the raw token is never stored
  id         String   @id
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  line1       String
  subdistrict String
  district    String
  province    String
  postcode    String
  isDefault   Boolean  @default(false)

  @@index([customerId])
}

/// A signed-in customer's cart, or a guest's (cookie token) until they sign in.
model Cart {
  id         String     @id @default(cuid())
  customerId String?    @unique
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestToken String?    @unique
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  cartId String
  cart   Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku    String
  item   InventoryItem @relation(fields: [sku], references: [sku], onDelete: Cascade)
  qty    Int

  @@id([cartId, sku])
}

model PcBuild {
  id         String        @id @default(cuid())
  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime      @default(now())
  items      PcBuildItem[]
}

model PcBuildItem {
  buildId String
  build   PcBuild       @relation(fields: [buildId], references: [id], onDelete: Cascade)
  /// cpu | mainboard | ram | vga | ssd | psu | case | cooler
  slot    String
  sku     String
  item    InventoryItem @relation(fields: [sku], references: [sku], onDelete: Cascade)
  qty     Int           @default(1)

  @@id([buildId, slot])
}

// ── Orders and payments (person B) ──────────────────────────────────────────

model Order {
  id           String      @id // ORD-2027-000123
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  /// pending_payment | paid | packing | shipped | completed | cancelled | expired | refunded
  status       String
  subtotal     Decimal     @db.Decimal(12, 2)
  discount     Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee  Decimal     @default(0) @db.Decimal(12, 2)
  /// Amount the customer pays (VAT included)
  total        Decimal     @db.Decimal(12, 2)
  couponCode   String?
  /// Delivery address as it was when the order was placed
  shipName     String
  shipPhone    String
  shipAddress  String
  carrier      String?
  trackingNo   String?
  createdAt    DateTime    @default(now())
  /// Unpaid orders expire here and their reserved stock is released
  expiresAt    DateTime
  paidAt       DateTime?
  shippedAt    DateTime?
  completedAt  DateTime?
  /// Set when staff cancel a paid order and return the money
  refundedAt   DateTime?
  refundReason String?
  /// Bank transfer reference of the refund
  refundRef    String?
  lines        OrderLine[]
  payments     Payment[]
  claims       Claim[]

  @@index([customerId, createdAt])
  @@index([status, expiresAt])
  @@index([couponCode])
}

/// Name and price are copied at order time, so later price changes never alter an order.
model OrderLine {
  id      String         @id @default(cuid())
  orderId String
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku     String
  item    InventoryItem  @relation(fields: [sku], references: [sku])
  name    String
  price   Decimal        @db.Decimal(12, 2)
  /// Purchase cost per unit when the order was placed — for gross profit (null on orders before it was recorded)
  cost    Decimal?       @db.Decimal(12, 2)
  qty     Int
  serials SerialNumber[]

  @@index([orderId])
}

model Payment {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// opn | promptpay_slip
  provider    String
  amount      Decimal        @db.Decimal(12, 2)
  /// pending | successful | failed | expired | refunded
  status      String         @default("pending")
  /// The provider's charge id (or the slip reference)
  providerRef String?        @unique
  qrImage     String?
  expiresAt   DateTime
  paidAt      DateTime?
  createdAt   DateTime       @default(now())
  events      PaymentEvent[]

  @@index([orderId])
}

/// Every webhook delivery, kept once per provider event id so a repeat delivery is ignored.
model PaymentEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  type      String
  raw       Json
  at        DateTime @default(now())
}

model Coupon {
  /// Upper-case code customers type at checkout
  code            String   @id
  /// percent | fixed
  kind            String
  value           Decimal  @db.Decimal(12, 2)
  /// Cap on a percent discount (baht); null = no cap
  maxDiscount     Decimal? @db.Decimal(12, 2)
  /// Minimum goods value (before discount) for the code to apply
  minSpend        Decimal  @default(0) @db.Decimal(12, 2)
  startsAt        DateTime
  endsAt          DateTime
  usageLimit      Int?
  /// Orders currently holding a use (unpaid orders that expire or are cancelled give theirs back)
  used            Int      @default(0)
  oncePerCustomer Boolean  @default(false)
  note            String   @default("")
  active          Boolean  @default(true)
  /// Shown on the storefront home page as a code customers can copy
  showOnShop      Boolean  @default(false)
  createdAt       DateTime @default(now())
}

/// A storefront promotion (B). `flash`: time-limited sale prices on listed products — the sale price is what the
/// storefront shows, the cart totals and checkout charges while it runs. `banner`: a home-page banner linking somewhere.
model Promotion {
  id        String          @id @default(cuid())
  /// flash | banner
  kind      String
  title     String
  subtitle  String          @default("")
  /// Where a banner leads (an in-app path such as /shop?cat=gpu)
  link      String          @default("")
  /// Banner colour from a fixed palette (cobalt | slate | teal | violet)
  tone      String          @default("cobalt")
  /// Banner poster uploaded by the shop (file name in the upload store); without one a designed poster is drawn
  image     String?
  /// Where a banner shows: hero (the sliding wide posters) | side (one tall poster beside them)
  slot      String          @default("hero")
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean         @default(true)
  sort      Int             @default(0)
  createdAt DateTime        @default(now())
  items     PromotionItem[]

  @@index([kind, active, endsAt])
}

/// A product's sale price in a flash promotion.
model PromotionItem {
  promotionId String
  promotion   Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  sku         String
  item        InventoryItem @relation(fields: [sku], references: [sku])
  salePrice   Decimal       @db.Decimal(12, 2)

  @@id([promotionId, sku])
  @@index([sku])
}

/// A warranty claim a customer raises for one serial-tracked unit they bought (person A).
/// submitted → received (the shop has the unit) → replaced (via replaceUnit in warranty.ts) | rejected; the customer may cancel while submitted.
model Claim {
  id         String       @id // CLM-2026-000001
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  serial     String
  unit       SerialNumber @relation(fields: [serial], references: [serial])
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  /// What is wrong, in the customer's words
  problem    String
  /// submitted | received | replaced | repaired | rejected | cancelled
  status     String       @default("submitted")
  /// Technician inspecting the unit (B: after-sales service)
  assigneeId String?
  assignee   User?        @relation("ClaimAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Serial of the replacement unit, once replaced
  newSerial  String?
  /// Shop's note to the customer: rejection reason, or how the new unit is sent back
  staffNote  String       @default("")
  createdAt  DateTime     @default(now())
  receivedAt DateTime?
  closedAt   DateTime?
  events     ClaimEvent[]
  images     ClaimImage[]
  parts      ClaimPart[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([serial])
  @@index([assigneeId, status])
}

/// A step in a claim's service log: technician findings, progress, repair. `public` ones are shown to the customer.
model ClaimEvent {
  id      String       @id @default(cuid())
  claimId String
  claim   Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  t       DateTime     @default(now())
  by      String
  text    String
  public  Boolean      @default(true)
  images  ClaimImage[]

  @@index([claimId, t])
}

/// Photos of a claimed unit: from the customer when filing, or from the technician (attached to an event).
model ClaimImage {
  id        String      @id @default(cuid())
  claimId   String
  claim     Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  eventId   String?
  event     ClaimEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// customer | staff
  kind      String
  file      String
  mime      String
  name      String
  size      Int
  ord       Int
  createdAt DateTime    @default(now())

  @@index([claimId])
}

/// Spare parts taken from stock to repair a claimed unit (non-serial items; the stock move carries the claim id as ref).
model ClaimPart {
  claimId String
  claim   Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sku     String
  item    InventoryItem @relation(fields: [sku], references: [sku])
  name    String
  qty     Int

  @@id([claimId, sku])
}

// ── Storefront chat (person A) ──────────────────────────────────────────────

/// One conversation from the storefront chat widget. A signed-in customer is linked by customerId; a visitor by a
/// cookie (only its sha256 is stored). bot → waiting (needs staff) → open (a staff member took it) → closed.
model ChatThread {
  id             String        @id @default(cuid())
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// sha256 of the visitor's chat cookie
  guestToken     String?       @unique
  /// Name / email a visitor typed in, so staff can address them and reply by email
  guestName      String        @default("")
  guestEmail     String        @default("")
  /// bot | waiting | open | closed
  status         String        @default("bot")
  assigneeId     String?
  assignee       User?         @relation("ChatAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  /// When the customer last had the chat open (polling), and when staff last read it — for unread counts and email
  customerSeenAt DateTime?
  staffSeenAt    DateTime?
  /// Last "staff replied" email, so a burst of replies sends one email
  emailedAt      DateTime?
  closedAt       DateTime?
  messages       ChatMessage[]

  @@index([status, updatedAt])
  @@index([customerId])
}

model ChatMessage {
  id        Int        @id @default(autoincrement())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// customer | bot | staff | system
  role      String
  text      String
  /// Staff member who wrote it (name kept even if the account is removed)
  staffId   String?
  by        String     @default("")
  createdAt DateTime   @default(now())

  @@index([threadId, id])
}
