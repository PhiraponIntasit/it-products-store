# Production settings for Vercel — set these in Vercel → Project → Settings → Environment Variables
# (scope: Production). Never commit real values.

# --- Database (Neon via Vercel Marketplace sets the first two for you) ---
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5"
# Direct connection — used only by `prisma migrate deploy` during the production build
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Ticket photos (Vercel Blob, private store — set automatically when you connect the store) ---
BLOB_STORE_ID="store_..."                   # newer Blob stores (OIDC); older ones give BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..." instead

# --- App ---
SHOW_DEMO_ACCOUNTS=false     # true only for a demo/presentation deploy seeded with sample data
DISPLAY_TZ=Asia/Bangkok
APPROVAL_LIMIT=50000
REORDER_FACTOR=3
DEFAULT_THEME=light
# COOKIE_SECURE — leave unset: Vercel is always HTTPS, cookies are Secure in production

# --- Email for "ลืมรหัสผ่าน" (required in production — reset requests fail without SMTP_HOST and APP_URL) ---
APP_URL="https://your-project.vercel.app"   # the site's public URL, used in emailed links
SMTP_HOST="smtp.gmail.com"                 # Gmail (app password), smtp.office365.com, smtp.resend.com:465, …
SMTP_PORT=587
SMTP_USER="you@example.com"
SMTP_PASS="app-password"
MAIL_FROM="IT Products Store <you@example.com>"

# --- Storefront chat assistant (optional) ---
# Without a key the chat uses the built-in rule-based assistant (free). With one, Claude answers first and hands off to staff.
ANTHROPIC_API_KEY=""                        # from console.anthropic.com — set it in Vercel, never commit it
CHAT_MODEL="claude-opus-5-5"                # optional; claude-sonnet-5-5 or claude-haiku-5-5 cost less per message
