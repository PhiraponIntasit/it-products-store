{
  "name": "apex-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "vercel-build": "sh scripts/vercel-build.sh",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:bootstrap:store": "tsx prisma/bootstrap-store.ts",
    "backup:photos": "node scripts/backup-photos.mjs",
    "test:e2e": "playwright test",
    "test:e2e:fresh": "prisma migrate reset --force && playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "barcode-detector": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "undici": "6.29.1",
    "zod": "4.6.7",
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.1"
  }
}
